# Weaver Environment Variables - Secrets Only
# ============================================================
# SECURITY: Copy this file to .env and fill in your values
# NEVER commit the .env file with real credentials!
# Service URLs should be in config/settings.toml
# ============================================================
#
# Environment Variable Format:
# - Prefix: WEAVER_ (single underscore)
# - Nested delimiter: __ (double underscore)
# - Example: WEAVER_POSTGRES__PASSWORD=secret
# ============================================================

# Environment
ENVIRONMENT=development

# PostgreSQL
WEAVER_POSTGRES__PASSWORD=your_secure_postgres_password

# Neo4j (REQUIRED in production - no default password)
WEAVER_NEO4J__PASSWORD=your_secure_neo4j_password

# Redis (optional, leave empty if no auth)
WEAVER_REDIS__PASSWORD=

# API Authentication (at least 32 characters in production)
WEAVER_API__API_KEY=your_secure_api_key_at_least_32_characters_long
# HMAC signing secret — independent from API key for dual-factor security
# Required in production when hmac_signing_enabled=true
# WEAVER_API__HMAC_SECRET=your_hmac_secret_key

# LLM Provider API Keys
# These override empty values in config/llm.toml
WEAVER_LLM__PROVIDERS__AIPING__API_KEY=your_aiping_api_key
WEAVER_LLM__PROVIDERS__DMX__API_KEY=your_dmx_api_key
# Ollama doesn't need a real API key
# WEAVER_LLM__PROVIDERS__OLLAMA__API_KEY=ollama

# Other provider keys as needed:
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Knowledge Cache ────────────────────────────────────────
# Knowledge cluster cache path (embedding is now handled by LLM Client)
KNOWLEDGE_CACHE_PATH=data/.cache/knowledge

# ── Phase 1: PG + Neo4j + Redis (primary stack) ─────────────
# Set all three backends; app uses primary databases.
# WEAVER_POSTGRES__DSN=postgresql+asyncpg://postgres:weavertest@localhost:5432/weaver
# WEAVER_NEO4J__URI=bolt://localhost:7687
# WEAVER_NEO4J__PASSWORD=weavertest
# WEAVER_REDIS__PASSWORD=
# WEAVER_API__PORT=18012

# ── Phase 2: DuckDB + LadybugDB fallback (offline/dev) ──────
# Empty PG/Neo4j DSN triggers automatic degradation to DuckDB/LadybugDB
# at startup. See CLAUDE.md "数据库故障转移" for the fallback contract.
# WEAVER_POSTGRES__DSN=
# WEAVER_NEO4J__PASSWORD=
# WEAVER_DUCKDB__DB_PATH=data/weaver.duckdb
# WEAVER_LADYBUG__DB_PATH=data/weaver_graph.ladybug
# WEAVER_API__PORT=18013

# ── Test Stack API Keys (32+ chars, prefix "weaver") ────────
# WEAVER_API__API_KEY=weaver_test_api_key_for_comprehensive_testing_2026
# WEAVER_API__ADMIN_API_KEY=weaver_test_admin_api_key_for_comprehensive_testing_2026